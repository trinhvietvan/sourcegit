<v:ChromelessWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:m="using:SourceGit.Models"
                    xmlns:v="using:SourceGit.Views"
                    xmlns:vm="using:SourceGit.ViewModels"
                    mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="300"
                    x:Class="SourceGit.Views.AddHostingAccount"
                    x:DataType="vm:AddHostingAccount"
                    x:Name="ThisControl"
                    Icon="/App.ico"
                    Title="{DynamicResource Text.AddHostingAccount}"
                    Width="520" SizeToContent="Height"
                    CanResize="False"
                    WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,Auto">
    <!-- TitleBar -->
    <Grid Grid.Row="0" Height="28" IsVisible="{Binding !#ThisControl.UseSystemWindowFrame}">
      <Border Background="{DynamicResource Brush.TitleBar}"
              BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border0}"
              PointerPressed="BeginMoveWindow"/>

      <Path Width="14" Height="14"
            Margin="10,0,0,0"
            HorizontalAlignment="Left"
            Data="{StaticResource Icons.User}"
            IsVisible="{OnPlatform True, macOS=False}"/>

      <TextBlock Classes="bold"
                 Text="{DynamicResource Text.AddHostingAccount}"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsHitTestVisible="False"/>

      <v:CaptionButtons HorizontalAlignment="Right"
                        IsCloseButtonOnly="True"
                        IsVisible="{OnPlatform True, macOS=False}"/>
    </Grid>

    <!-- Body -->
    <StackPanel Grid.Row="1" Margin="16" Orientation="Vertical">
      <Grid RowDefinitions="32,32,Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*">
        <TextBlock Grid.Row="0" Grid.Column="0"
                   HorizontalAlignment="Right" Margin="0,0,8,0"
                   Text="{DynamicResource Text.AddHostingAccount.Provider}"/>
        <ComboBox Grid.Row="0" Grid.Column="1"
                  Height="28" Padding="8,0"
                  HorizontalAlignment="Stretch" VerticalAlignment="Center"
                  ItemsSource="{Binding Providers}"
                  SelectedItem="{Binding Provider, Mode=TwoWay}"
                  IsEnabled="{Binding !IsUpdate}">
          <ComboBox.ItemTemplate>
            <DataTemplate DataType="m:HostingProvider">
              <TextBlock Text="{Binding Name}"/>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Grid.Row="1" Grid.Column="0"
                   HorizontalAlignment="Right" Margin="0,0,8,0"
                   Text="{DynamicResource Text.AddHostingAccount.Host}"/>
        <TextBox Grid.Row="1" Grid.Column="1"
                 Height="28" CornerRadius="3"
                 VerticalAlignment="Center"
                 Text="{Binding Host, Mode=TwoWay}"
                 IsEnabled="{Binding IsHostEditable}"/>

        <TextBlock Grid.Row="2" Grid.Column="0"
                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                   Text="{DynamicResource Text.AddHostingAccount.Email}"
                   IsVisible="{Binding Provider.NeedEmail}"/>
        <TextBox Grid.Row="2" Grid.Column="1"
                 Height="28" Margin="0,2" CornerRadius="3"
                 VerticalAlignment="Center"
                 Watermark="{DynamicResource Text.AddHostingAccount.Email.Placeholder}"
                 Text="{Binding Email, Mode=TwoWay}"
                 IsVisible="{Binding Provider.NeedEmail}"/>

        <TextBlock Grid.Row="3" Grid.Column="0"
                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                   Text="{DynamicResource Text.AddHostingAccount.Token}"/>
        <Grid Grid.Row="3" Grid.Column="1" Margin="0,2" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
          <TextBox Grid.Column="0"
                   Height="28" CornerRadius="3"
                   PasswordChar="*"
                   RevealPassword="{Binding #ToggleShowToken.IsChecked, Mode=OneWay}"
                   Text="{Binding Token, Mode=TwoWay}">
            <TextBox.InnerRightContent>
              <ToggleButton x:Name="ToggleShowToken"
                            Classes="toggle_untracked"
                            Width="26" Height="14"/>
            </TextBox.InnerRightContent>
          </TextBox>
          <Button Grid.Column="1"
                  Classes="flat"
                  Height="28" Margin="8,0,0,0" Padding="8,0"
                  Content="{DynamicResource Text.AddHostingAccount.CreateToken}"
                  Command="{Binding OpenTokenPage}"/>
        </Grid>

        <TextBlock Grid.Row="4" Grid.Column="1"
                   Margin="0,4,0,0"
                   Classes="small"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource Brush.FG2}">
          <Run Text="{DynamicResource Text.AddHostingAccount.Scopes}"/>
          <Run Text="{Binding Provider.Scopes}"/>
          <LineBreak/>
          <Run Text="{DynamicResource Text.AddHostingAccount.Scopes.SSHKey}"/>
          <Run Text="{Binding Provider.SSHKeyScopes}"/>
        </TextBlock>

        <TextBlock Grid.Row="5" Grid.Column="0"
                   Margin="0,12,8,0"
                   HorizontalAlignment="Right" VerticalAlignment="Center"
                   Text="{DynamicResource Text.AddHostingAccount.Browser}"
                   IsVisible="{Binding CanSignInWithBrowser}"/>
        <Button Grid.Row="5" Grid.Column="1"
                Classes="flat"
                Height="28" Padding="12,0" Margin="0,12,0,0"
                HorizontalAlignment="Left"
                Content="{DynamicResource Text.AddHostingAccount.SignInWithBrowser}"
                Click="OnSignInWithBrowser"
                IsEnabled="{Binding !IsBusy}"
                IsVisible="{Binding CanSignInWithBrowser}"/>
      </Grid>

      <TextBlock Margin="0,12,0,0"
                 Classes="small"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource Brush.FG2}"
                 Text="{DynamicResource Text.AddHostingAccount.Tip}"/>

      <TextBlock Margin="0,8,0,0"
                 TextWrapping="Wrap"
                 Foreground="Red"
                 Text="{Binding Error}"
                 IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

      <StackPanel Margin="0,16,0,0" Orientation="Horizontal" HorizontalAlignment="Center">
        <Button Classes="flat primary"
                Width="80"
                Content="{DynamicResource Text.Sure}"
                Click="OnSure"
                IsEnabled="{Binding !IsBusy}"
                HotKey="Enter"/>
        <Button Classes="flat"
                Width="80"
                Margin="16,0,0,0"
                Content="{DynamicResource Text.Cancel}"
                Click="OnCancel"
                IsEnabled="{Binding CanCancel}"/>
        <v:LoadingIcon Width="14" Height="14"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       IsVisible="{Binding IsBusy}"/>
      </StackPanel>
    </StackPanel>
  </Grid>
</v:ChromelessWindow>
